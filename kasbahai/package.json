{
  "name": "kasbahai",
  "private": true,
  "version": "0.1.0",
  "description": "KasbahAI YouTube Regeneration Studio - monorepo root",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/** --filter=./apps/** run build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r run test:integration",
    "db:generate": "pnpm --filter @kasbahai/db run generate",
    "db:migrate": "pnpm --filter @kasbahai/db run migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^2.1.9"
  }
}
