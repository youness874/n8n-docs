# Copy to .env.local for local development. Never commit real secrets.

# Postgres connection used by packages/db
DATABASE_URL=postgres://kasbahai:kasbahai@localhost:5432/kasbahai

# Object storage (local driver by default; see packages/storage)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.data/storage

# AI gateway (see packages/ai-gateway). Provider is pluggable; the mock
# provider requires no key and is used by default in development/tests.
AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_DEFAULT_MODEL=mock-structured-v1
# ANTHROPIC_API_KEY=

# Background jobs (see packages/jobs). "memory" driver is used by default
# in development/tests; swap for a durable driver before production use.
JOBS_DRIVER=memory
